meta {
  name: Get Loyalty Transactions
  type: http
  seq: 33
}

get {
  url: {{server}}/odata/v1/LoyaltyPointTransactions?companyId={{companyId}}&customerId={{customerId}}
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  customerId: {{customerId}}
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}
