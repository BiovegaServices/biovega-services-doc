meta {
  name: Get Address Types
  type: http
  seq: 48
}

get {
  url: {{server}}/odata/v1/AddressTypes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Global lookup — no companyId needed. Codes: BILLING, DELIVERY, HOME,
  WORK, OTHER.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}
