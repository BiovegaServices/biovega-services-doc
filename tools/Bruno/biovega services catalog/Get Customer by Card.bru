meta {
  name: Get Customer by Card
  type: http
  seq: 42
}

get {
  url: {{server}}/odata/v1/Customers?companyId={{companyId}}&cardNumber={{cardNumber}}
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  cardNumber: 1234567890
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}

docs {
  POS card-scan lookup: narrows the customer list to the holder of the
  given loyalty card number. Empty list when no card matches.

  cardNumber is captured by Save Customer Card — run that first for a hit.
}
