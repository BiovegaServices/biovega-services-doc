meta {
  name: Get Customers
  type: http
  seq: 29
}

get {
  url: {{server}}/odata/v1/Customers?companyId={{companyId}}&$expand=Cards,Addresses
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  $expand: Cards
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}
