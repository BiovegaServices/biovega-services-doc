meta {
  name: Get Loyalty Transaction Types
  type: http
  seq: 38
}

get {
  url: {{server}}/odata/v1/LoyaltyTransactionTypes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}

docs {
  Global lookup — no companyId needed. Codes: EARN, REDEEM, EXPIRE,
  ADJUST_POS, ADJUST_NEG, WELCOME, BIRTHDAY.
}
