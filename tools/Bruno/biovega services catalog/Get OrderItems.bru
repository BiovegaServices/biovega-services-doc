meta {
  name: Get OrderItems
  type: http
  seq: 20
}

get {
  url: {{server}}/odata/v1/orderItems?companyId={{companyId}}&orderId={{orderId}}
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  orderId: {{orderId}}
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a result list", function() {
    const body = res.getBody();
    expect(body.value ?? body).to.be.an("array");
  });
}
