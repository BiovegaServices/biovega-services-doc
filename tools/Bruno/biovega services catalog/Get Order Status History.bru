meta {
  name: Get Order Status History
  type: http
  seq: 27
}

get {
  url: {{server}}/odata/v1/orders/{{orderId}}/statushistory?companyId={{companyId}}
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("contains the Paid transition", function() {
    const body = res.getBody();
    const rows = body.value ?? body;
    expect(rows).to.be.an("array");
    const toStatuses = rows.map(r => r.toStatus ?? r.ToStatus);
    expect(toStatuses).to.include("Paid");
  });
}
