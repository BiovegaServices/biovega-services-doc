meta {
  name: Get Products expand ProductLifeCycle
  type: http
  seq: 9
}

get {
  url: {{server}}/odata/v1/products?companyId={{companyId}}&$expand=ProductLifecycle
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  $expand: ProductLifecycle
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a result list", function() {
    const body = res.getBody();
    const rows = body.value ?? body;
    expect(rows).to.be.an("array");
  });
}
