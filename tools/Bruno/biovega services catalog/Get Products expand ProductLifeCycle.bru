meta {
  name: Get Products expand ProductLifeCycle
  type: http
  seq: 7
}

get {
  url: {{server}}/odata/products?companyId={{companyId}}&$expand=ProductLifecycle
  body: none
  auth: bearer
}

params:query {
  companyId: {{companyId}}
  $expand: ProductLifecycle
}

auth:bearer {
  token: {{access_token}}
}
